  },
  "Trace response middleware": {
    "scope": "python",
    "prefix": "fastapi.middleware.trace",
    "description": "Expose the active OpenTelemetry trace and span IDs",
    "body": [
      "from opentelemetry import trace",
      "from starlette.middleware.base import BaseHTTPMiddleware",
      "",
      "",
      "class TraceContextMiddleware(BaseHTTPMiddleware):",
      "    async def dispatch(self, request, call_next):",
      "        response = await call_next(request)",
      "        span = trace.get_current_span()",
      "        if span.is_recording():",
      "            context = span.get_span_context()",
      "            response.headers[\"x-trace-id\"] = format(context.trace_id, \"032x\")",
      "            response.headers[\"x-span-id\"] = format(context.span_id, \"016x\")",
      "        return response",
      "$0"
    ]
  },
