  "FastAPI application with lifespan": {
    "scope": "python",
    "prefix": "fastapi.app.lifespan",
    "description": "Create a FastAPI application with startup and shutdown",
    "body": [
      "from contextlib import asynccontextmanager",
      "",
      "from fastapi import FastAPI",
      "",
      "",
      "@asynccontextmanager",
      "async def lifespan(app: FastAPI):",
      "    ${1:# Initialize shared clients and resources}",
      "    yield",
      "    ${2:# Close shared clients and resources}",
      "",
      "",
      "app = FastAPI(",
      "    title=\"${3:Application API}\",",
      "    docs_url=\"/swagger\",",
      "    version=\"${4:1.0.0}\",",
      "    lifespan=lifespan,",
      ")",
      "$0"
    ]
  },
