{
  "Tenant collection accessor": {
    "scope": "python",
    "prefix": "fastapi.mongo.collection",
    "description": "Resolve a tenant-specific MongoDB collection",
    "body": [
      "async def get_${1:resource}_collection(tenant: str, collection_name: str = \"${2:cs_resources}\"):",
      "    try:",
      "        database, _ = await mongo_client_rel_service(tenant)",
      "    except ValueError as exc:",
      "        if \"not found\" in str(exc).lower():",
      "            raise HTTPException(status_code=400, detail=\"Invalid tenant\") from exc",
      "        raise HTTPException(status_code=500, detail=\"Database connection failed\") from exc",
      "    return database[collection_name]",
      "$0"
    ]
  },
  "Tenant-scoped find one": {
    "scope": "python",
    "prefix": "fastapi.mongo.find_one",
    "description": "Find one active tenant resource or raise 404",
    "body": [
      "collection = await get_${1:resource}_collection(tenant)",
      "document = collection.find_one(",
      "    {\"${2:resource_id}\": ${2:resource_id}, \"is_deleted\": False},",
      "    {\"_id\": 0},",
      ")",
      "if document is None:",
      "    raise HTTPException(status_code=404, detail=\"${3:Resource not found}\")",
      "$0"
    ]
  },
  "Paginated MongoDB query": {
    "scope": "python",
    "prefix": "fastapi.mongo.page",
    "description": "Query one extra document to calculate has_more",
    "body": [
      "query = {\"is_deleted\": False, ${1:\"drilldown_list\": node}}",
      "documents = list(",
      "    collection.find(query, {\"_id\": 0})",
      "    .sort(${2:\"updated_at\"}, ${3:-1})",
      "    .skip(offset)",
      "    .limit(limit + 1)",
      ")",
      "has_more = len(documents) > limit",
      "items = documents[:limit]",
      "$0"
    ]
  },
  "MongoDB partial update": {
    "scope": "python",
    "prefix": "fastapi.mongo.update",
    "description": "Apply supplied Pydantic fields to one active document",
    "body": [
      "update_data = payload.model_dump(exclude_unset=True)",
      "if not update_data:",
      "    raise HTTPException(status_code=400, detail=\"No fields supplied\")",
      "update_data[\"last_updated_at\"] = datetime.now(timezone.utc)",
      "result = collection.update_one(",
      "    {\"${1:resource_id}\": ${1:resource_id}, \"is_deleted\": False},",
      "    {\"\\$set\": update_data},",
      ")",
      "if result.matched_count == 0:",
      "    raise HTTPException(status_code=404, detail=\"${2:Resource not found}\")",
      "$0"
    ]
  },
  "MongoDB soft delete": {
    "scope": "python",
    "prefix": "fastapi.mongo.soft_delete",
    "description": "Soft-delete one active document",
    "body": [
      "result = collection.update_one(",
      "    {\"${1:resource_id}\": ${1:resource_id}, \"is_deleted\": False},",
      "    {\"\\$set\": {\"is_deleted\": True, \"last_updated_at\": datetime.now(timezone.utc)}},",
      ")",
      "if result.matched_count == 0:",
      "    raise HTTPException(status_code=404, detail=\"${2:Resource not found}\")",
      "$0"
    ]
  },
  "MongoDB bulk update": {
    "scope": "python",
    "prefix": "fastapi.mongo.update_many",
    "description": "Update a set of active linked documents",
    "body": [
      "result = collection.update_many(",
      "    {\"${1:resource_id}\": {\"\\$in\": ${2:resource_ids}}, \"is_deleted\": False},",
      "    {\"\\$set\": {${3:\"status\": status}}},",
      ")",
      "modified_count = result.modified_count",
      "$0"
    ]
  },
  "MongoDB aggregation": {
    "scope": "python",
    "prefix": "fastapi.mongo.aggregate",
    "description": "Aggregate counts grouped by a resource field",
    "body": [
      "pipeline = [",
      "    {\"\\$match\": {\"is_deleted\": False, ${1:\"tenant\": tenant}}},",
      "    {\"\\$group\": {\"_id\": \"\\$${2:status}\", \"count\": {\"\\$sum\": 1}}},",
      "]",
      "counts = {doc[\"_id\"]: doc[\"count\"] for doc in collection.aggregate(pipeline)}",
      "$0"
    ]
  },
  "MongoDB indexes": {
    "scope": "python",
    "prefix": "fastapi.mongo.indexes",
    "description": "Create common active-resource indexes during onboarding",
    "body": [
      "from pymongo import ASCENDING, DESCENDING",
      "",
      "collection.create_index([(\"${1:resource_id}\", ASCENDING)], unique=True)",
      "collection.create_index(",
      "    [(\"is_deleted\", ASCENDING), (\"${2:updated_at}\", DESCENDING)],",
      "    name=\"idx_active_${2:updated_at}\",",
      ")",
      "$0"
    ]
  }
}
