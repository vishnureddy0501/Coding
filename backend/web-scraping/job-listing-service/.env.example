APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://job_user:job_password@postgres:5432/job_listing
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_JOB_TOPIC=jobs.normalized.v1
KAFKA_CONSUMER_GROUP=job-listing-worker-v1
